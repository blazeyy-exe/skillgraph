# SkillGraph environment
# Copy to .env.local and fill in real values. Never commit secrets.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SkillGraph

# Label-only demo fixtures. Leave false in any shared or production environment.
SKILLGRAPH_DEMO_MODE=false

# --- Supabase (required for auth and data) ---
# Project URL and anon key are safe to expose to the browser.
# The service role key is server-only. Do not prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (required from Phase 2 for intelligence) ---
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_MODEL_FAST=gpt-4.1-mini
AI_USER_DAILY_TOKEN_BUDGET=250000

# --- Optional ---
# LOG_LEVEL=info
